{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/properties",
      "destination": "/areas#homes",
      "permanent": true
    },
    {
      "source": "/reassurance",
      "destination": "/how-it-works#buying-safely",
      "permanent": true
    },
    {
      "source": "/rentals",
      "destination": "/how-it-works#rentals",
      "permanent": true
    },
    {
      "source": "/properties.html",
      "destination": "/areas#homes",
      "permanent": true
    },
    {
      "source": "/reassurance.html",
      "destination": "/how-it-works#buying-safely",
      "permanent": true
    },
    {
      "source": "/rentals.html",
      "destination": "/how-it-works#rentals",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
